# =============================================================================
#  X-Bot — file cau hinh mau.
#  Copy thanh .env roi dien gia tri thuc. KHONG commit file .env len git.
#    cp .env.example .env
#
#  Tren server, scripts/server/thiet-lap.sh se tu sinh .env voi
#  SECRET_KEY va DB_PASSWORD ngau nhien.
# =============================================================================

# --- Ten mien cong khai ---
# Dung cho nginx va cho nut "mo webview xem mail" trong Telegram.
DOMAIN=ten-mien-cua-ban.com

# Dia chi web cong khai (bat buoc https de webview mo duoc trong Telegram).
# De trong thi vao Admin -> Bot Settings -> PUBLIC_BASE_URL de dat sau.
PUBLIC_BASE_URL=https://ten-mien-cua-ban.com

# --- Django ---
# Sinh chuoi ngau nhien dai, vi du:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=doi-thanh-chuoi-ngau-nhien-that-dai
DEBUG=0
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://ten-mien-cua-ban.com

# --- PostgreSQL ---
# DB_HOST=db la ten service trong docker-compose (giu nguyen khi chay Docker).
DB_NAME=readmailbot
DB_USER=readmailbot
DB_PASSWORD=doi-thanh-mat-khau-manh
DB_HOST=db
DB_PORT=5432

# --- Cong cua trang quan tri tren MAY CHU (host) ---
# Container luon lang nghe cong 8080 ben trong; day la cong map ra host.
ADMIN_PORT=8085

# --- Tuy chon ---
# Khoang thoi gian (giay) BotManager kiem tra thay doi bot trong DB.
BOT_CHECK_INTERVAL=10
